@page "/dealers"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Dealer> DealerRepository
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Dealers - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Dealers</h1>
    <a href="/dealers/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Dealer
    </a>
</div>

@if (dealers == null)
{
    <p><em>Loading...</em></p>
}
else if (!dealers.Any())
{
    <div class="alert alert-info">No dealers found. Create your first dealer!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dealer in dealers)
                {
                    <tr>
                        <td>@dealer.Name</td>
                        <td>@dealer.Company</td>
                        <td>@dealer.Email</td>
                        <td>@dealer.Phone</td>
                        <td>
                            @if (dealer.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/dealers/edit/@dealer.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteDealer(dealer.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Dealer>? dealers;

    protected override async Task OnInitializedAsync()
    {
        await LoadDealers();
    }

    private async Task LoadDealers()
    {
        var allDealers = await DealerRepository.GetAllAsync();
        dealers = allDealers.ToList();
    }

    private async Task DeleteDealer(int id)
    {
        if (await DealerRepository.ExistsAsync(id))
        {
            await DealerRepository.DeleteAsync(id);
            await LoadDealers();
        }
    }
}
