@page "/buyers/edit/{id:int}"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Buyer> BuyerRepository
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Edit Buyer - CMA IMS</PageTitle>

<h1>Edit Buyer</h1>

@if (buyer == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="@buyer" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="buyer.Name" />
                </div>

                <div class="mb-3">
                    <label for="company" class="form-label">Company</label>
                    <InputText id="company" class="form-control" @bind-Value="buyer.Company" />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="buyer.Email" />
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label">Phone</label>
                    <InputText id="phone" class="form-control" @bind-Value="buyer.Phone" />
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">Address</label>
                    <InputTextArea id="address" class="form-control" @bind-Value="buyer.Address" rows="3" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="buyer.IsActive" />
                    <label class="form-check-label" for="isActive">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a href="/buyers" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Buyer? buyer;

    protected override async Task OnInitializedAsync()
    {
        buyer = await BuyerRepository.GetByIdAsync(Id);
        if (buyer == null)
        {
            Navigation.NavigateTo("/buyers");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (buyer != null)
        {
            buyer.ModifiedDate = DateTime.UtcNow;
            await BuyerRepository.UpdateAsync(buyer);
            Navigation.NavigateTo("/buyers");
        }
    }
}
