@page "/employees"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Employee> EmployeeRepository
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor")]

<PageTitle>Employees - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Employees</h1>
    <a href="/employees/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Employee
    </a>
</div>

@if (employees == null)
{
    <p><em>Loading...</em></p>
}
else if (!employees.Any())
{
    <div class="alert alert-info">No employees found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Salary</th>
                    <th>Joining Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in employees)
                {
                    <tr>
                        <td>@employee.EmployeeCode</td>
                        <td>@employee.Name</td>
                        <td><span class="badge bg-info">@employee.EmployeeType</span></td>
                        <td>@employee.Email</td>
                        <td>@employee.Phone</td>
                        <td>@employee.MonthlySalary.ToString("C")</td>
                        <td>@employee.JoiningDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (employee.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/employees/edit/@employee.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/employees/salary/@employee.Id" class="btn btn-sm btn-success">Salary</a>
                            <a href="/employees/leave/@employee.Id" class="btn btn-sm btn-info">Leave</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Employee>? employees;

    protected override async Task OnInitializedAsync()
    {
        var allEmployees = await EmployeeRepository.GetAllAsync();
        employees = allEmployees.ToList();
    }
}
