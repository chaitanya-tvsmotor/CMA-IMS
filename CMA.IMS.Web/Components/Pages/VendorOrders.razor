@page "/vendor-orders"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Vendor Orders - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Vendor Orders (Purchase Orders)</h1>
    <AuthorizeView Roles="Admin,Manager">
        <a href="/vendor-orders/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Vendor Order
        </a>
    </AuthorizeView>
</div>

@if (vendorOrders == null)
{
    <p><em>Loading...</em></p>
}
else if (!vendorOrders.Any())
{
    <div class="alert alert-info">No vendor orders found. Create your first vendor order!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Vendor</th>
                    <th>Order Date</th>
                    <th>Expected Delivery</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in vendorOrders)
                {
                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.Vendor.Name</td>
                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td>@(order.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "Not set")</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>
                            @switch (order.Status)
                            {
                                case VendorOrderStatus.Pending:
                                    <span class="badge bg-warning">@order.Status</span>
                                    break;
                                case VendorOrderStatus.Confirmed:
                                    <span class="badge bg-info">@order.Status</span>
                                    break;
                                case VendorOrderStatus.Shipped:
                                    <span class="badge bg-primary">@order.Status</span>
                                    break;
                                case VendorOrderStatus.Received:
                                    <span class="badge bg-success">@order.Status</span>
                                    break;
                                case VendorOrderStatus.Cancelled:
                                    <span class="badge bg-danger">@order.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <AuthorizeView Roles="Admin,Manager">
                                <a href="/vendor-orders/edit/@order.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteVendorOrder(order.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </AuthorizeView>
                            <AuthorizeView Roles="Supervisor,Accountant">
                                <a href="/vendor-orders/edit/@order.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<VendorOrder>? vendorOrders;

    protected override async Task OnInitializedAsync()
    {
        await LoadVendorOrders();
    }

    private async Task LoadVendorOrders()
    {
        vendorOrders = await DbContext.VendorOrders
            .Include(vo => vo.Vendor)
            .OrderByDescending(vo => vo.OrderDate)
            .ToListAsync();
    }

    private async Task DeleteVendorOrder(int id)
    {
        var order = await DbContext.VendorOrders.FindAsync(id);
        if (order != null)
        {
            DbContext.VendorOrders.Remove(order);
            await DbContext.SaveChangesAsync();
            await LoadVendorOrders();
        }
    }
}
