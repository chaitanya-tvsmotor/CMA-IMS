@page "/categories/edit/{id:int}"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Category> CategoryRepository
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Edit Category - CMA IMS</PageTitle>

<h1>Edit Category</h1>

@if (category == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="@category" OnValidSubmit="@HandleValidSubmit" FormName="CategoryEditForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="category.Name" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <InputTextArea id="description" class="form-control" @bind-Value="category.Description" rows="3" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="category.IsActive" />
                    <label class="form-check-label" for="isActive">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a href="/categories" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Category? category;

    protected override async Task OnInitializedAsync()
    {
        category = await CategoryRepository.GetByIdAsync(Id);
        if (category == null)
        {
            Navigation.NavigateTo("/categories");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (category != null)
        {
            category.ModifiedDate = DateTime.UtcNow;
            await CategoryRepository.UpdateAsync(category);
            Navigation.NavigateTo("/categories");
        }
    }
}
