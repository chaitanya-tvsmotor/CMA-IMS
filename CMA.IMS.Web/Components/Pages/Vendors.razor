@page "/vendors"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Vendor> VendorRepository
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Vendors - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Vendors</h1>
    <a href="/vendors/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Vendor
    </a>
</div>

@if (vendors == null)
{
    <p><em>Loading...</em></p>
}
else if (!vendors.Any())
{
    <div class="alert alert-info">No vendors found. Create your first vendor!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vendor in vendors)
                {
                    <tr>
                        <td>@vendor.Name</td>
                        <td>@vendor.ContactPerson</td>
                        <td>@vendor.Email</td>
                        <td>@vendor.Phone</td>
                        <td>
                            @if (vendor.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/vendors/edit/@vendor.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteVendor(vendor.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Vendor>? vendors;

    protected override async Task OnInitializedAsync()
    {
        await LoadVendors();
    }

    private async Task LoadVendors()
    {
        var allVendors = await VendorRepository.GetAllAsync();
        vendors = allVendors.ToList();
    }

    private async Task DeleteVendor(int id)
    {
        if (await VendorRepository.ExistsAsync(id))
        {
            await VendorRepository.DeleteAsync(id);
            await LoadVendors();
        }
    }
}
