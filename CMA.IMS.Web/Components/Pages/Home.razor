@page "/"
@using CMA.IMS.Infrastructure.Data
@using CMA.IMS.Core.Entities
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Dashboard - CMA Inventory Management</PageTitle>

<h1 class="mb-4">Dashboard</h1>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Products</h5>
                <p class="card-text display-4">@productCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Categories</h5>
                <p class="card-text display-4">@categoryCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Vendors</h5>
                <p class="card-text display-4">@vendorCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Orders</h5>
                <p class="card-text display-4">@orderCount</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Low Stock Products</h5>
            </div>
            <div class="card-body">
                @if (lowStockProducts.Any())
                {
                    <ul class="list-group">
                        @foreach (var product in lowStockProducts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @product.Name
                                <span class="badge bg-danger rounded-pill">@product.StockQuantity left</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>All products are well stocked!</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Recent Orders</h5>
            </div>
            <div class="card-body">
                @if (recentOrders.Any())
                {
                    <ul class="list-group">
                        @foreach (var order in recentOrders)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@order.OrderNumber</strong>
                                    <br />
                                    <small>@order.OrderDate.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="badge bg-primary rounded-pill">@order.Status</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No recent orders.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int productCount = 0;
    private int categoryCount = 0;
    private int vendorCount = 0;
    private int orderCount = 0;
    private List<Product> lowStockProducts = new();
    private List<Order> recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        productCount = await DbContext.Products.CountAsync();
        categoryCount = await DbContext.Categories.CountAsync();
        vendorCount = await DbContext.Vendors.CountAsync();
        orderCount = await DbContext.Orders.CountAsync();
        
        lowStockProducts = await DbContext.Products
            .Where(p => p.StockQuantity <= p.ReorderLevel && p.IsActive)
            .OrderBy(p => p.StockQuantity)
            .Take(5)
            .ToListAsync();
        
        recentOrders = await DbContext.Orders
            .Include(o => o.Customer)
            .OrderByDescending(o => o.OrderDate)
            .Take(5)
            .ToListAsync();
    }
}

