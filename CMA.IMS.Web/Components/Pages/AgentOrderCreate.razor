@page "/agent-order-create"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Agent Bulk Order - CMA IMS</PageTitle>

<h1>Create Bulk Order for Multiple Customers</h1>
<p class="text-muted">Select an agent, customers, and add products to create orders for multiple customers at once.</p>

<div class="row">
    <div class="col-md-10">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Step 1: Select Agent and Customers</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="agent" class="form-label">Marketing Agent</label>
                    <select id="agent" class="form-select" @onchange="OnAgentChanged">
                        <option value="">-- Select Agent --</option>
                        @foreach (var agent in agents)
                        {
                            <option value="@agent.Id">@agent.Name (@agent.EmployeeCode)</option>
                        }
                    </select>
                </div>

                @if (selectedAgentId.HasValue)
                {
                    <div class="mb-3">
                        <label class="form-label">Select Customers for this Order</label>
                        <div class="row">
                            @foreach (var customer in availableCustomers)
                            {
                                <div class="col-md-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" 
                                               id="customer-@customer.Id" 
                                               checked="@selectedCustomerIds.Contains(customer.Id)"
                                               @onchange="() => ToggleCustomer(customer.Id)" />
                                        <label class="form-check-label" for="customer-@customer.Id">
                                            @customer.Name (@customer.Company)
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (selectedCustomerIds.Any())
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Step 2: Add Products for Selected Customers</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Product</label>
                            <select class="form-select" @bind="selectedProductId">
                                <option value="">-- Select Product --</option>
                                @foreach (var product in products)
                                {
                                    <option value="@product.Id">@product.Name - @product.UnitPrice.ToString("C")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantity</label>
                            <input type="number" class="form-control" @bind="productQuantity" min="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">&nbsp;</label>
                            <button class="btn btn-primary w-100" @onclick="AddProductToOrders">
                                <i class="bi bi-plus-circle"></i> Add to All Selected Customers
                            </button>
                        </div>
                    </div>

                    <h6>Products per Customer:</h6>
                    @foreach (var customerId in selectedCustomerIds)
                    {
                        var customer = availableCustomers.FirstOrDefault(c => c.Id == customerId);
                        if (customer != null)
                        {
                            <div class="card mb-2">
                                <div class="card-header">
                                    <strong>@customer.Name</strong> - Order #@($"ORD-{DateTime.Now:yyyyMMdd}-{customerId}")
                                </div>
                                <div class="card-body">
                                    @if (customerProducts.ContainsKey(customerId) && customerProducts[customerId].Any())
                                    {
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Quantity</th>
                                                    <th>Unit Price</th>
                                                    <th>Total</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in customerProducts[customerId])
                                                {
                                                    var product = products.FirstOrDefault(p => p.Id == item.ProductId);
                                                    <tr>
                                                        <td>@product?.Name</td>
                                                        <td>@item.Quantity</td>
                                                        <td>@item.UnitPrice.ToString("C")</td>
                                                        <td>@item.TotalPrice.ToString("C")</td>
                                                        <td>
                                                            <button class="btn btn-sm btn-danger" 
                                                                    @onclick="() => RemoveProductFromCustomer(customerId, item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                                    <td><strong>@customerProducts[customerId].Sum(i => i.TotalPrice).ToString("C")</strong></td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No products added yet</p>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-success btn-lg" @onclick="CreateOrders">
                    <i class="bi bi-check-circle"></i> Create All Orders
                </button>
                <a href="/orders" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@code {
    private List<Agent> agents = new();
    private List<Customer> availableCustomers = new();
    private List<Product> products = new();
    private int? selectedAgentId;
    private List<int> selectedCustomerIds = new();
    private int? selectedProductId;
    private int productQuantity = 1;
    private Dictionary<int, List<OrderItem>> customerProducts = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        agents = await DbContext.Agents.Where(a => a.IsActive).ToListAsync();
        products = await DbContext.Products.Where(p => p.IsActive).ToListAsync();
    }

    private async Task OnAgentChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var agentId))
        {
            selectedAgentId = agentId;
            availableCustomers = await DbContext.Customers
                .Where(c => c.IsActive && (c.AgentId == agentId || c.AgentId == null))
                .ToListAsync();
        }
        else
        {
            selectedAgentId = null;
            availableCustomers.Clear();
        }
        selectedCustomerIds.Clear();
        customerProducts.Clear();
    }

    private void ToggleCustomer(int customerId)
    {
        if (selectedCustomerIds.Contains(customerId))
        {
            selectedCustomerIds.Remove(customerId);
            customerProducts.Remove(customerId);
        }
        else
        {
            selectedCustomerIds.Add(customerId);
            customerProducts[customerId] = new List<OrderItem>();
        }
    }

    private void AddProductToOrders()
    {
        if (!selectedProductId.HasValue || productQuantity <= 0)
        {
            message = "Please select a product and enter a valid quantity.";
            return;
        }

        var product = products.FirstOrDefault(p => p.Id == selectedProductId.Value);
        if (product == null) return;

        foreach (var customerId in selectedCustomerIds)
        {
            if (!customerProducts.ContainsKey(customerId))
            {
                customerProducts[customerId] = new List<OrderItem>();
            }

            var orderItem = new OrderItem
            {
                ProductId = product.Id,
                Quantity = productQuantity,
                UnitPrice = product.UnitPrice,
                TotalPrice = product.UnitPrice * productQuantity
            };

            customerProducts[customerId].Add(orderItem);
        }

        message = $"Added {product.Name} to all selected customers.";
        selectedProductId = null;
        productQuantity = 1;
    }

    private void RemoveProductFromCustomer(int customerId, OrderItem item)
    {
        if (customerProducts.ContainsKey(customerId))
        {
            customerProducts[customerId].Remove(item);
        }
    }

    private async Task CreateOrders()
    {
        if (!selectedAgentId.HasValue)
        {
            message = "Please select an agent.";
            return;
        }

        var ordersCreated = 0;
        foreach (var customerId in selectedCustomerIds)
        {
            if (!customerProducts.ContainsKey(customerId) || !customerProducts[customerId].Any())
                continue;

            var order = new Order
            {
                OrderNumber = $"ORD-{DateTime.Now:yyyyMMddHHmmss}-{customerId}",
                OrderDate = DateTime.UtcNow,
                CustomerId = customerId,
                AgentId = selectedAgentId.Value,
                Status = OrderStatus.Pending,
                TotalAmount = customerProducts[customerId].Sum(i => i.TotalPrice),
                OrderItems = customerProducts[customerId]
            };

            DbContext.Orders.Add(order);
            ordersCreated++;
        }

        await DbContext.SaveChangesAsync();
        message = $"Successfully created {ordersCreated} orders!";
        
        // Reset form after 2 seconds
        await Task.Delay(2000);
        Navigation.NavigateTo("/orders");
    }
}
