@page "/products"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor,SalesAgent,Accountant")]

<PageTitle>Products - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a href="/products/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Product
    </a>
</div>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else if (!products.Any())
{
    <div class="alert alert-info">No products found. Create your first product!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Unit Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td>@product.SKU</td>
                        <td>@product.Name</td>
                        <td>@product.Category.Name</td>
                        <td>@product.UnitPrice.ToString("C")</td>
                        <td>
                            @if (product.StockQuantity <= product.ReorderLevel)
                            {
                                <span class="badge bg-danger">@product.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@product.StockQuantity</span>
                            }
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/products/edit/@product.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(product.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await DbContext.Products
            .Include(p => p.Category)
            .ToListAsync();
    }

    private async Task DeleteProduct(int id)
    {
        var product = await DbContext.Products.FindAsync(id);
        if (product != null)
        {
            DbContext.Products.Remove(product);
            await DbContext.SaveChangesAsync();
            await LoadProducts();
        }
    }
}
