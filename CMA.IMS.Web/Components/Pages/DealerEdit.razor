@page "/dealers/edit/{id:int}"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Dealer> DealerRepository
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor,SalesAgent")]

<PageTitle>Edit Dealer - CMA IMS</PageTitle>

<h1>Edit Dealer</h1>

@if (dealer == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="@dealer" OnValidSubmit="@HandleValidSubmit" FormName="DealerEditForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="dealer.Name" />
                </div>

                <div class="mb-3">
                    <label for="company" class="form-label">Company</label>
                    <InputText id="company" class="form-control" @bind-Value="dealer.Company" />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="dealer.Email" />
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label">Phone</label>
                    <InputText id="phone" class="form-control" @bind-Value="dealer.Phone" />
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">Address</label>
                    <InputTextArea id="address" class="form-control" @bind-Value="dealer.Address" rows="3" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="dealer.IsActive" />
                    <label class="form-check-label" for="isActive">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a href="/dealers" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Dealer? dealer;

    protected override async Task OnInitializedAsync()
    {
        dealer = await DealerRepository.GetByIdAsync(Id);
        if (dealer == null)
        {
            Navigation.NavigateTo("/dealers");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (dealer != null)
        {
            dealer.ModifiedDate = DateTime.UtcNow;
            await DealerRepository.UpdateAsync(dealer);
            Navigation.NavigateTo("/dealers");
        }
    }
}
