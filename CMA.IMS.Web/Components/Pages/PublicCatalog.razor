@page "/catalog"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Product Catalog - CMA IMS</PageTitle>

<div class="container">
    <h1 class="my-4">Product Catalog</h1>

    @if (products == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info">No products available at the moment.</div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-4">
                <select class="form-select" @onchange="FilterByCategory">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select class="form-select" @onchange="FilterByBrand">
                    <option value="">All Brands</option>
                    @foreach (var brand in brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            @foreach (var product in filteredProducts)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            @if (product.Brand != null)
                            {
                                <p class="text-muted"><small>Brand: @product.Brand.Name</small></p>
                            }
                            <p class="card-text">@product.Description</p>
                            @if (product.Category != null)
                            {
                                <p><span class="badge bg-info">@product.Category.Name</span></p>
                            }
                            @if (product.SubCategory != null)
                            {
                                <p><span class="badge bg-secondary">@product.SubCategory.Name</span></p>
                            }
                            @if (product.StockQuantity > 0)
                            {
                                <p class="text-success"><strong>In Stock</strong></p>
                            }
                            else
                            {
                                <p class="text-danger"><strong>Out of Stock</strong></p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Product>? products;
    private List<Product> filteredProducts = new();
    private List<Category> categories = new();
    private List<Brand> brands = new();
    private int? selectedCategoryId;
    private int? selectedBrandId;

    protected override async Task OnInitializedAsync()
    {
        products = await DbContext.Products
            .Include(p => p.Category)
            .Include(p => p.SubCategory)
            .Include(p => p.Brand)
            .Where(p => p.IsActive)
            .ToListAsync();

        categories = await DbContext.Categories.Where(c => c.IsActive).ToListAsync();
        brands = await DbContext.Brands.Where(b => b.IsActive).ToListAsync();

        filteredProducts = products;
    }

    private void FilterByCategory(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var categoryId))
        {
            selectedCategoryId = categoryId;
        }
        else
        {
            selectedCategoryId = null;
        }
        ApplyFilters();
    }

    private void FilterByBrand(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var brandId))
        {
            selectedBrandId = brandId;
        }
        else
        {
            selectedBrandId = null;
        }
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredProducts = products?
            .Where(p => !selectedCategoryId.HasValue || p.CategoryId == selectedCategoryId.Value)
            .Where(p => !selectedBrandId.HasValue || p.BrandId == selectedBrandId.Value)
            .ToList() ?? new List<Product>();
    }
}
