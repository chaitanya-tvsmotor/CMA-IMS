@page "/buyers"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Buyer> BuyerRepository
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Buyers - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Buyers</h1>
    <a href="/buyers/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Buyer
    </a>
</div>

@if (buyers == null)
{
    <p><em>Loading...</em></p>
}
else if (!buyers.Any())
{
    <div class="alert alert-info">No buyers found. Create your first buyer!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var buyer in buyers)
                {
                    <tr>
                        <td>@buyer.Name</td>
                        <td>@buyer.Company</td>
                        <td>@buyer.Email</td>
                        <td>@buyer.Phone</td>
                        <td>
                            @if (buyer.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/buyers/edit/@buyer.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteBuyer(buyer.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Buyer>? buyers;

    protected override async Task OnInitializedAsync()
    {
        await LoadBuyers();
    }

    private async Task LoadBuyers()
    {
        var allBuyers = await BuyerRepository.GetAllAsync();
        buyers = allBuyers.ToList();
    }

    private async Task DeleteBuyer(int id)
    {
        if (await BuyerRepository.ExistsAsync(id))
        {
            await BuyerRepository.DeleteAsync(id);
            await LoadBuyers();
        }
    }
}
