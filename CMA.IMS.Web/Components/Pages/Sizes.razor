@page "/sizes"
@using CMA.IMS.Core.Entities
@using CMA.IMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Size> SizeRepository
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Sizes - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Sizes</h1>
    <a href="/sizes/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Size
    </a>
</div>

@if (sizes == null)
{
    <p><em>Loading...</em></p>
}
else if (!sizes.Any())
{
    <div class="alert alert-info">No sizes found. Create your first size!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var size in sizes)
                {
                    <tr>
                        <td>@size.Name</td>
                        <td>@size.Description</td>
                        <td>
                            @if (size.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/sizes/edit/@size.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteSize(size.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Size>? sizes;

    protected override async Task OnInitializedAsync()
    {
        await LoadSizes();
    }

    private async Task LoadSizes()
    {
        var allSizes = await SizeRepository.GetAllAsync();
        sizes = allSizes.ToList();
    }

    private async Task DeleteSize(int id)
    {
        if (await SizeRepository.ExistsAsync(id))
        {
            await SizeRepository.DeleteAsync(id);
            await LoadSizes();
        }
    }
}
