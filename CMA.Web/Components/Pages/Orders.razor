@page "/orders"
@using CMA.Core.Entities
@using CMA.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor,SalesAgent,Accountant")]

<PageTitle>Orders - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Orders</h1>
    <a href="/orders/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Order
    </a>
</div>

@if (orders == null)
{
    <p><em>Loading...</em></p>
}
else if (!orders.Any())
{
    <div class="alert alert-info">No orders found. Create your first order!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Dealer</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orders)
                {
                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.Dealer.Name</td>
                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>
                            @switch (order.Status)
                            {
                                case OrderStatus.Pending:
                                    <span class="badge bg-warning">@order.Status</span>
                                    break;
                                case OrderStatus.Confirmed:
                                    <span class="badge bg-info">@order.Status</span>
                                    break;
                                case OrderStatus.Processing:
                                    <span class="badge bg-primary">@order.Status</span>
                                    break;
                                case OrderStatus.Shipped:
                                    <span class="badge bg-success">@order.Status</span>
                                    break;
                                case OrderStatus.Delivered:
                                    <span class="badge bg-success">@order.Status</span>
                                    break;
                                case OrderStatus.Cancelled:
                                    <span class="badge bg-danger">@order.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a href="/orders/edit/@order.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteOrder(order.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Order>? orders;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        orders = await DbContext.Orders
            .Include(o => o.Dealer)
            .OrderByDescending(o => o.OrderDate)
            .ToListAsync();
    }

    private async Task DeleteOrder(int id)
    {
        var order = await DbContext.Orders.FindAsync(id);
        if (order != null)
        {
            DbContext.Orders.Remove(order);
            await DbContext.SaveChangesAsync();
            await LoadOrders();
        }
    }
}
