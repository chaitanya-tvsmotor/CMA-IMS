@page "/brands"
@using CMA.Core.Entities
@using CMA.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Brand> BrandRepository
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor")]

<PageTitle>Brands - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Brands</h1>
    <a href="/brands/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Brand
    </a>
</div>

@if (brands == null)
{
    <p><em>Loading...</em></p>
}
else if (!brands.Any())
{
    <div class="alert alert-info">No brands found. Create your first brand!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var brand in brands)
                {
                    <tr>
                        <td>@brand.Name</td>
                        <td>@brand.Description</td>
                        <td>
                            @if (brand.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/brands/edit/@brand.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteBrand(brand.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Brand>? brands;

    protected override async Task OnInitializedAsync()
    {
        await LoadBrands();
    }

    private async Task LoadBrands()
    {
        var allBrands = await BrandRepository.GetAllAsync();
        brands = allBrands.ToList();
    }

    private async Task DeleteBrand(int id)
    {
        if (await BrandRepository.ExistsAsync(id))
        {
            await BrandRepository.DeleteAsync(id);
            await LoadBrands();
        }
    }
}
