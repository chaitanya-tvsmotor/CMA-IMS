@page "/vendors/edit/{id:int}"
@using CMA.Core.Entities
@using CMA.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Vendor> VendorRepository
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Edit Vendor - CMA IMS</PageTitle>

<h1>Edit Vendor</h1>

@if (vendor == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="@vendor" OnValidSubmit="@HandleValidSubmit" FormName="VendorEditForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="vendor.Name" />
                </div>

                <div class="mb-3">
                    <label for="contactPerson" class="form-label">Contact Person</label>
                    <InputText id="contactPerson" class="form-control" @bind-Value="vendor.ContactPerson" />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="vendor.Email" />
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label">Phone</label>
                    <InputText id="phone" class="form-control" @bind-Value="vendor.Phone" />
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">Address</label>
                    <InputTextArea id="address" class="form-control" @bind-Value="vendor.Address" rows="3" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="vendor.IsActive" />
                    <label class="form-check-label" for="isActive">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a href="/vendors" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Vendor? vendor;

    protected override async Task OnInitializedAsync()
    {
        vendor = await VendorRepository.GetByIdAsync(Id);
        if (vendor == null)
        {
            Navigation.NavigateTo("/vendors");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (vendor != null)
        {
            vendor.ModifiedDate = DateTime.UtcNow;
            await VendorRepository.UpdateAsync(vendor);
            Navigation.NavigateTo("/vendors");
        }
    }
}
