@page "/employees/edit/{id:int}"
@using CMA.Core.Entities
@using CMA.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor")]

<PageTitle>Edit Employee - CMA</PageTitle>

<h1>Edit Employee</h1>

@if (employee == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <EditForm Model="@employee" OnValidSubmit="@HandleValidSubmit" FormName="EmployeeEditForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="name" class="form-label">Name *</label>
                        <InputText id="name" class="form-control" @bind-Value="employee.Name" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="code" class="form-label">Employee Code *</label>
                        <InputText id="code" class="form-control" @bind-Value="employee.EmployeeCode" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">Email</label>
                        <InputText id="email" type="email" class="form-control" @bind-Value="employee.Email" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="phone" class="form-label">Phone</label>
                        <InputText id="phone" class="form-control" @bind-Value="employee.Phone" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">Address</label>
                    <InputTextArea id="address" class="form-control" @bind-Value="employee.Address" rows="2" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="type" class="form-label">Employee Type *</label>
                        <InputSelect id="type" class="form-select" @bind-Value="employee.EmployeeType" required>
                            @foreach (EmployeeType type in Enum.GetValues(typeof(EmployeeType)))
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="salary" class="form-label">Monthly Salary *</label>
                        <InputNumber id="salary" class="form-control" @bind-Value="employee.MonthlySalary" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="joiningDate" class="form-label">Joining Date *</label>
                        <InputDate id="joiningDate" class="form-control" @bind-Value="employee.JoiningDate" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="leavingDate" class="form-label">Leaving Date</label>
                        <InputDate id="leavingDate" class="form-control" @bind-Value="employee.LeavingDate" />
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="employee.IsActive" />
                    <label class="form-check-label" for="isActive">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Update
                    </button>
                    <a href="/employees" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="button" class="btn btn-danger" @onclick="DeleteEmployee">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Employee? employee;

    protected override async Task OnInitializedAsync()
    {
        employee = await DbContext.Employees.FindAsync(Id);
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            DbContext.Employees.Update(employee!);
            await DbContext.SaveChangesAsync();
            Navigation.NavigateTo("/employees");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating employee: {ex.Message}");
        }
    }

    private async Task DeleteEmployee()
    {
        if (employee != null && confirm($"Are you sure you want to delete {employee.Name}?"))
        {
            DbContext.Employees.Remove(employee);
            await DbContext.SaveChangesAsync();
            Navigation.NavigateTo("/employees");
        }
    }

    private bool confirm(string message)
    {
        // In real app, use JavaScript confirm dialog
        return true;
    }
}
