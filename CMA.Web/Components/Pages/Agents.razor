@page "/agents"
@using CMA.Core.Entities
@using CMA.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IRepository<Agent> AgentRepository
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Agents - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Marketing Agents</h1>
    <a href="/agents/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Agent
    </a>
</div>

@if (agents == null)
{
    <p><em>Loading...</em></p>
}
else if (!agents.Any())
{
    <div class="alert alert-info">No agents found. Create your first agent!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in agents)
                {
                    <tr>
                        <td>@agent.EmployeeCode</td>
                        <td>@agent.Name</td>
                        <td>@agent.Email</td>
                        <td>@agent.Phone</td>
                        <td>
                            @if (agent.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/agents/edit/@agent.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAgent(agent.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Agent>? agents;

    protected override async Task OnInitializedAsync()
    {
        await LoadAgents();
    }

    private async Task LoadAgents()
    {
        var allAgents = await AgentRepository.GetAllAsync();
        agents = allAgents.ToList();
    }

    private async Task DeleteAgent(int id)
    {
        if (await AgentRepository.ExistsAsync(id))
        {
            await AgentRepository.DeleteAsync(id);
            await LoadAgents();
        }
    }
}
