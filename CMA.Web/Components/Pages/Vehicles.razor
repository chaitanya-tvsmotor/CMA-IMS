@page "/vehicles"
@using CMA.Core.Entities
@using CMA.Infrastructure.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,Manager,Supervisor")]

<PageTitle>Vehicles - CMA IMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Vehicle Management</h1>
    <a href="/vehicles/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Vehicle
    </a>
</div>

@if (vehicles == null)
{
    <p><em>Loading...</em></p>
}
else if (!vehicles.Any())
{
    <div class="alert alert-info">No vehicles found. Add your first vehicle!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Vehicle Number</th>
                    <th>Type</th>
                    <th>Make/Model</th>
                    <th>Year</th>
                    <th>Assigned Driver</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in vehicles)
                {
                    <tr>
                        <td>@vehicle.VehicleNumber</td>
                        <td><span class="badge bg-info">@vehicle.VehicleType</span></td>
                        <td>@vehicle.Make @vehicle.Model</td>
                        <td>@vehicle.Year</td>
                        <td>@(vehicle.AssignedDriver?.Name ?? "Unassigned")</td>
                        <td>
                            @if (vehicle.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a href="/vehicles/edit/@vehicle.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/vehicles/maintenance/@vehicle.Id" class="btn btn-sm btn-info">Maintenance</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Vehicle>? vehicles;

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        vehicles = await DbContext.Vehicles
            .Include(v => v.AssignedDriver)
            .ToListAsync();
    }
}
